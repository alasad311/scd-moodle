{
  "name": "scd-moodle",
  "version": "1.1.4",
  "description": "SCD Moodle – incognito browser for moodle.scd.edu.om",
  "author": "SCD",
  "repository": {
    "type": "git",
    "url": "https://github.com/alasad311/scd-moodle.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "SCD Moodle",
        "executableName": "scd-moodle",
        "icon": "./assets/icon",
        "asar": true,
        "extraResource": [],
        "ignore": [
          "node_modules/electron$",
          "^/\\.git",
          "^/\\.github",
          "^/\\.claude",
          "^/out",
          "^/node_modules/[^/]+/\\.yarn(/|$)",
          "\\.yarnrc\\.yml$",
          "^/node_modules/(.+/)?(test|tests|__tests__|\\.github)(/|$)",
          "^/node_modules/.+\\.(md|markdown|map|ts)$",
          "^/node_modules/.+/(karma\\.conf\\.js|jest\\.config\\.js|\\.eslintrc[^/]*|\\.jsfmtrc|\\.travis\\.yml)$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "scd_moodle",
            "authors": "SCD",
            "description": "SCD Moodle – incognito browser for moodle.scd.edu.om",
            "setupIcon": "./assets/icon.ico",
            "iconUrl": "https://raw.githubusercontent.com/alasad311/scd-moodle/main/assets/icon.ico"
          },
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "name": "SCD Moodle",
            "format": "ULFO",
            "icon": "./assets/icon.icns"
          },
          "platforms": [
            "darwin"
          ]
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "alasad311",
              "name": "scd-moodle"
            },
            "draft": true,
            "prerelease": false
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/publisher-github": "^7.11.1",
    "electron": "^27.0.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
